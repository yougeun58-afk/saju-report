{
  "version": 2,
  "builds": [
    {
      "src": "api/server.py",
      "use": "@vercel/python"
    },
    {
      "src": "static/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "api/server.py"
    },
    {
      "src": "/terms.html",
      "dest": "static/terms.html"
    },
    {
      "src": "/privacy.html",
      "dest": "static/privacy.html"
    },
    {
      "src": "/refund.html",
      "dest": "static/refund.html"
    },
    {
      "src": "/(.*)",
      "dest": "static/index.html"
    }
  ]
}